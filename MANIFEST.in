# Files to include in the source distribution (sdist) so that
# `pip install <sdist>` can compile the _fht_native extension on the fly.
# NOTE: keep this file pure ASCII - setuptools reads it with the locale
# encoding on some platforms (e.g. GBK on Windows).
include LICENSE
include README.md
recursive-include src/Modal_Decomposition/Utils/_Hilbert/_C *
include src/Modal_Decomposition/Utils/_Hilbert/_fht_native.pyx
recursive-include src/Modal_Decomposition/Utils/_Slepian/_C *.c *.h
